# 복사해서 .env로 쓰거나 배포 환경변수에 넣는다. 실제 키는 절대 커밋하지 않는다.

# 내비 경로 API (하나만 있어도 됨, 둘 다 없으면 교통 패턴 모델로 계산)
TMAP_APP_KEY=            # SK open API 콘솔(openapi.sk.com)에서 발급한 TMAP appKey
KAKAO_REST_KEY=          # Kakao Developers REST API 키 (카카오모빌리티 길찾기 사용 권한 필요)

# 시설 어댑터 인증 · 번호판 해시 솔트 (시설 LPR과 같은 솔트를 공유)
FACILITY_API_KEY=
FACILITY_SALT=

# Phase 2 내비 파트너 웹훅 서명 비밀값
PARTNER_WEBHOOK_SECRET=

# 프론트엔드 출처 (쉼표 구분)
CORS_ORIGINS=https://paul-kim1014.github.io,http://localhost:8765,http://127.0.0.1:8765

# 1이면 합성 수요로 가상 시설을 채우고 방문객 데모 엔드포인트를 연다
DEMO=1
TICK_SECONDS=60
